diff --git a/Inc/det_emit.h b/Inc/det_emit.h
new file mode 100644
index 0000000..ffde74a
--- /dev/null
+++ b/Inc/det_emit.h
@@ -0,0 +1,90 @@
+/**
+ ******************************************************************************
+ * @file    det_emit.h
+ * @brief   Per-frame person-detection / occupancy emitter over USART1.
+ *
+ * ADD-ON module (not part of the original ST sample). Emits one line per
+ * processed inference frame on the existing console UART (USART1 / ST-Link
+ * VCP, 115200 8N1) so a host can read structured occupancy data. It reuses
+ * the project's existing printf redirection (PUTCHAR_PROTOTYPE -> USART1);
+ * no new UART init is required.
+ *
+ * Wire protocol (integers only, no %f):
+ *   DET <seq> <ts_ms> <count> [<id>:<cx>:<cy>:<w>:<h>:<conf> ...]
+ *     seq   : uint32 frame counter (increments once per emitted line)
+ *     ts_ms : HAL_GetTick() value
+ *     count : number of detections emitted this frame (== tuple count)
+ *     cx,cy,w,h : box center/size in PERMILLE (0..1000)
+ *     conf      : confidence in PERCENT (0..100)
+ * A header-only line ("DET <seq> <ts> 0") is emitted when count == 0.
+ ******************************************************************************
+ */
+
+#ifndef DET_EMIT_H
+#define DET_EMIT_H
+
+#include <stdint.h>
+#include "od_pp_output_if.h"   /* od_pp_outBuffer_t */
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* APP_DET_EMIT: master compile-time switch for the detection emitter.
+ * Default ON. To disable: set to 0 (or comment out the define) and rebuild.
+ * Both the emit body (det_emit.c) and the single call site (app.c) then
+ * compile out / to a no-op, so the feature is fully removable from one place. */
+#ifndef APP_DET_EMIT
+#define APP_DET_EMIT 1
+#endif
+
+/*
+ * tbox_info: tracked-box payload shared between app.c and det_emit.c.
+ *
+ * Type-sharing approach: this typedef was MOVED here from app.c, where it was
+ * a file-local typedef guarded by TRACKER_MODULE. It is now declared here
+ * (unconditionally) so DetEmit_Frame() can take it by const reference and so
+ * the module compiles in both tracker and no-tracker builds. The layout is
+ * byte-for-byte identical to the original definition; app.c now relies on this
+ * declaration via #include "det_emit.h".
+ *
+ * NOTE: a tracked box carries NO confidence (neither tbox_info nor the
+ * tracker's trk_tbox_t has a conf field), so in tracking mode the emitted
+ * conf is reported as 0. Real confidence is only available in no-tracking
+ * mode, where it comes from od_pp_outBuffer_t.conf.
+ */
+typedef struct {
+  double cx;
+  double cy;
+  double w;
+  double h;
+  uint32_t id;
+} tbox_info;
+
+/**
+ * @brief Emit one wire-protocol line for the current inference frame.
+ *
+ * @param ts_ms       timestamp (HAL_GetTick()) for this frame
+ * @param count       caller's detection count (advisory; the function derives
+ *                    the actual emitted count from the active source so the
+ *                    header count and tuple count always agree)
+ * @param tboxes      tracked boxes (used when tracking_on); may be NULL
+ * @param ntb         number of valid entries in @p tboxes
+ * @param dets        raw post-process detections (used when !tracking_on)
+ * @param ndet        number of valid entries in @p dets
+ * @param tracking_on non-zero selects @p tboxes (ids + conf=0); zero selects
+ *                    @p dets (id=0 + real conf)
+ *
+ * Integer-only formatting; the line length is bounded (tuples capped). Safe to
+ * call once per frame from the post-process thread.
+ */
+void DetEmit_Frame(uint32_t ts_ms, uint32_t count,
+                   const tbox_info *tboxes, uint32_t ntb,
+                   const od_pp_outBuffer_t *dets, uint32_t ndet,
+                   int tracking_on);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* DET_EMIT_H */
