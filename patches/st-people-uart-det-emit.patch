+                  tracking_enabled ? (uint32_t)disp.info.tboxes_valid_nb
+                                   : (uint32_t)pp_output.nb_detect,
+                  disp.info.tboxes, (uint32_t)disp.info.tboxes_valid_nb,
+                  pp_output.pOutBuff, (uint32_t)pp_output.nb_detect,
