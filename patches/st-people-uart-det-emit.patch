+#else
+    DetEmit_Frame(HAL_GetTick(),
+                  (uint32_t)pp_output.nb_detect,
+                  NULL, 0u,
+                  pp_output.pOutBuff, (uint32_t)pp_output.nb_detect,
+                  0);
+#endif
+#endif
+
     bqueue_put_free(&nn_output_queue);
