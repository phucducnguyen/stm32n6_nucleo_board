@@ -857,6 +851,28 @@ static void pp_thread_fct(void *arg)
     ret = xSemaphoreGive(disp.lock);
     assert(ret == pdTRUE);
 
+#if defined(APP_DET_EMIT) && (APP_DET_EMIT)
+    /* Emit one per-frame detection/occupancy line over USART1 for the host.
+     * Placed AFTER releasing disp.lock (UART TX is slow, must not stall the
